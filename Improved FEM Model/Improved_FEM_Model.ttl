@prefix : <http://example.org/fem-ontology#> .
@prefix fem: <http://example.org/fem-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/fem-ontology#> .

<http://example.org/fem-ontology> rdf:type owl:Ontology ;
                                   rdfs:comment "Complete FEM/FeRAM drOWLing ontology implementation aligned with draw.io model and specification." ;
                                   rdfs:label "FEM/FeRAM drOWLing Ontology (Full Implementation)" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/fem-ontology#belongsToFlow
fem:belongsToFlow rdf:type owl:ObjectProperty ;
                  rdfs:domain fem:Unit_Process ;
                  rdfs:range fem:Process_Flow ;
                  rdfs:comment "Links a process step to the process flow it belongs to." ;
                  rdfs:label "belongsToFlow" .


###  http://example.org/fem-ontology#consistsOf
fem:consistsOf rdf:type owl:ObjectProperty ;
               rdfs:domain fem:Artifact ;
               rdfs:range fem:Artifact ;
               rdfs:comment "Specifies structural or physical sub-components that make up a device assembly or artifact." ;
               rdfs:label "consistsOf" .


###  http://example.org/fem-ontology#contains
fem:contains rdf:type owl:ObjectProperty ;
             rdfs:domain fem:Memory_Cell_Architecture ;
             rdfs:range fem:Artifact ;
             rdfs:comment "Indicates functional hardware elements contained within a memory cell architecture." ;
             rdfs:label "contains" .


###  http://example.org/fem-ontology#depositsMaterial
fem:depositsMaterial rdf:type owl:ObjectProperty ;
                     rdfs:domain fem:Deposition ;
                     rdfs:range fem:Material ;
                     rdfs:comment "Records which material a deposition step deposits." ;
                     rdfs:label "depositsMaterial" .


###  http://example.org/fem-ontology#directlyPrecedes
fem:directlyPrecedes rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf fem:precedes ;
                     rdfs:domain fem:Unit_Process ;
                     rdfs:range fem:Unit_Process ;
                     rdfs:comment "Indicates an immediate sequential process step precedence." ;
                     rdfs:label "directlyPrecedes" .


###  http://example.org/fem-ontology#etchesMaterial
fem:etchesMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain fem:Etch ;
                   rdfs:range fem:Material ;
                   rdfs:comment "Records which material an etch step targets." ;
                   rdfs:label "etchesMaterial" .


###  http://example.org/fem-ontology#flowProducesArchitecture
fem:flowProducesArchitecture rdf:type owl:ObjectProperty ;
                             rdfs:domain fem:Process_Flow ;
                             rdfs:range [ rdf:type owl:Class ;
                                          owl:unionOf ( fem:Layer_Stack
                                                        fem:Memory_Cell_Architecture
                                                      )
                                        ] ;
                             rdfs:comment "Links a process flow to the layer stack or architecture it produces." ;
                             rdfs:label "flowProducesArchitecture" .


###  http://example.org/fem-ontology#hasAmbient
fem:hasAmbient rdf:type owl:ObjectProperty ;
               rdfs:domain fem:Thermal_Process ;
               rdfs:range fem:Material ;
               rdfs:comment "Records ambient process gases used during thermal steps." ;
               rdfs:label "hasAmbient" .


###  http://example.org/fem-ontology#hasBottomElectrode
fem:hasBottomElectrode rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf fem:hasElectrode ;
                       rdfs:domain fem:MFM ;
                       rdfs:range fem:Electrode_Material ;
                       rdfs:comment "Records the bottom electrode of an MFM stack." ;
                       rdfs:label "hasBottomElectrode" .


###  http://example.org/fem-ontology#hasElectrode
fem:hasElectrode rdf:type owl:ObjectProperty ;
                 rdfs:domain fem:Layer_Stack ;
                 rdfs:range fem:Electrode_Material ;
                 rdfs:comment "Generic relation linking a stack to an electrode material." ;
                 rdfs:label "hasElectrode" .


###  http://example.org/fem-ontology#hasFerroelectricLayer
fem:hasFerroelectricLayer rdf:type owl:ObjectProperty ;
                          rdfs:domain fem:Layer_Stack ;
                          rdfs:range fem:Ferroelectric_Material ;
                          rdfs:comment "Records the ferroelectric layer in a stack." ;
                          rdfs:label "hasFerroelectricLayer" .


###  http://example.org/fem-ontology#hasInput
fem:hasInput rdf:type owl:ObjectProperty ;
             rdfs:domain fem:Unit_Process ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( fem:Artifact
                                        fem:Material
                                      )
                        ] ;
             rdfs:comment "Inputs consumed or acted upon by a unit process." ;
             rdfs:label "hasInput" .


###  http://example.org/fem-ontology#hasInterfacialLayer
fem:hasInterfacialLayer rdf:type owl:ObjectProperty ;
                        rdfs:domain fem:Layer_Stack ;
                        rdfs:range fem:Interfacial_Layer_Material ;
                        rdfs:comment "Records interfacial layer present in the stack." ;
                        rdfs:label "hasInterfacialLayer" .


###  http://example.org/fem-ontology#hasLayer
fem:hasLayer rdf:type owl:ObjectProperty ;
             rdfs:domain fem:Layer_Stack ;
             rdfs:range fem:Material ;
             rdfs:comment "Generic link connecting a layer stack to constituent materials." ;
             rdfs:label "hasLayer" .


###  http://example.org/fem-ontology#hasMeasurement
fem:hasMeasurement rdf:type owl:ObjectProperty ;
                   rdfs:domain fem:Artifact ;
                   rdfs:range fem:Measurement ;
                   rdfs:comment "Links a specimen artifact to a measurement record." ;
                   rdfs:label "hasMeasurement" .


###  http://example.org/fem-ontology#hasPhase
fem:hasPhase rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( fem:Layer_Stack
                                         fem:Material
                                       )
                         ] ;
             rdfs:range fem:Phase_State ;
             rdfs:comment "Links a material to its crystallographic phase state." ;
             rdfs:label "hasPhase" .


###  http://example.org/fem-ontology#hasTopElectrode
fem:hasTopElectrode rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf fem:hasElectrode ;
                    rdfs:domain fem:MFM ;
                    rdfs:range fem:Electrode_Material ;
                    rdfs:comment "Records the top electrode of an MFM stack." ;
                    rdfs:label "hasTopElectrode" .


###  http://example.org/fem-ontology#measuredOn
fem:measuredOn rdf:type owl:ObjectProperty ;
               rdfs:domain fem:Measurement ;
               rdfs:range fem:Artifact ;
               rdfs:comment "Records which artifact specimen a measurement was taken on." ;
               rdfs:label "measuredOn" .


###  http://example.org/fem-ontology#measurementMethod
fem:measurementMethod rdf:type owl:ObjectProperty ;
                      rdfs:domain fem:Measurement ;
                      rdfs:range fem:Measurement_Method ;
                      rdfs:comment "Records technique used for a measurement." ;
                      rdfs:label "measurementMethod" .


###  http://example.org/fem-ontology#measuresProperty
fem:measuresProperty rdf:type owl:ObjectProperty ;
                     rdfs:domain fem:Measurement ;
                     rdfs:range fem:Measured_Property ;
                     rdfs:comment "Records the physical property quantified by a measurement." ;
                     rdfs:label "measuresProperty" .


###  http://example.org/fem-ontology#precedes
fem:precedes rdf:type owl:ObjectProperty ;
             rdfs:domain fem:Unit_Process ;
             rdfs:range fem:Unit_Process ;
             rdfs:comment "Orders process steps chronologically." ;
             rdfs:label "precedes" .


###  http://example.org/fem-ontology#scavengesOxygenFrom
fem:scavengesOxygenFrom rdf:type owl:ObjectProperty ;
                        rdfs:domain fem:Electrode_Material ;
                        rdfs:range fem:Ferroelectric_Material ;
                        rdfs:comment "Records oxygen-scavenging action by an electrode." ;
                        rdfs:label "scavengesOxygenFrom" .


###  http://example.org/fem-ontology#transformsPhase
fem:transformsPhase rdf:type owl:ObjectProperty ;
                    rdfs:domain fem:Unit_Process ;
                    rdfs:range fem:Phase_State ;
                    rdfs:comment "Records crystallographic phase change induced by a process." ;
                    rdfs:label "transformsPhase" .


###  http://example.org/fem-ontology#usesEquipment
fem:usesEquipment rdf:type owl:ObjectProperty ;
                  rdfs:domain fem:Unit_Process ;
                  rdfs:range fem:Equipment ;
                  rdfs:comment "Records equipment used during a process step." ;
                  rdfs:label "usesEquipment" .


###  http://example.org/fem-ontology#usesStack
fem:usesStack rdf:type owl:ObjectProperty ;
              rdfs:domain fem:Memory_Cell_Architecture ;
              rdfs:range fem:Layer_Stack ;
              rdfs:comment "Links a cell architecture to its associated layer stack." ;
              rdfs:label "usesStack" .


#################################################################
#    Data properties
#################################################################

###  http://example.org/fem-ontology#flowTargetsNode
fem:flowTargetsNode rdf:type owl:DatatypeProperty ;
                    rdfs:domain fem:Process_Flow ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Specifies the technology node targeted by the process flow." ;
                    rdfs:label "flowTargetsNode" .


###  http://example.org/fem-ontology#hasAppliedVoltage_V
fem:hasAppliedVoltage_V rdf:type owl:DatatypeProperty ;
                        rdfs:domain fem:Measurement ;
                        rdfs:range xsd:double ;
                        rdfs:comment "Specifies the operating or testing voltage applied during metrology in Volts." ;
                        rdfs:label "hasAppliedVoltage_V" .


###  http://example.org/fem-ontology#hasArraySize_bit
fem:hasArraySize_bit rdf:type owl:DatatypeProperty ;
                     rdfs:domain fem:Memory_Array ;
                     rdfs:range xsd:int ;
                     rdfs:comment "Specifies total memory capacity of an array instance in bits." ;
                     rdfs:label "hasArraySize_bit" .


###  http://example.org/fem-ontology#hasBasePressure_mbar
fem:hasBasePressure_mbar rdf:type owl:DatatypeProperty ;
                         rdfs:domain fem:Unit_Process ;
                         rdfs:range xsd:double ;
                         rdfs:comment "Specifies initial baseline chamber pressure in millibars prior to processing." ;
                         rdfs:label "hasBasePressure_mbar" .


###  http://example.org/fem-ontology#hasCellArea_um2
fem:hasCellArea_um2 rdf:type owl:DatatypeProperty ;
                    rdfs:domain fem:Memory_Cell_Architecture ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Specifies the physical surface footprint area of a memory cell in square micrometers." ;
                    rdfs:label "hasCellArea_um2" .


###  http://example.org/fem-ontology#hasCycleCount
fem:hasCycleCount rdf:type owl:DatatypeProperty ;
                  rdfs:domain fem:Unit_Process ;
                  rdfs:range xsd:int ;
                  rdfs:comment "Specifies the total number of execution cycles in cyclical deposition or testing steps." ;
                  rdfs:label "hasCycleCount" .


###  http://example.org/fem-ontology#hasDopantConcentration_atPct
fem:hasDopantConcentration_atPct rdf:type owl:DatatypeProperty ;
                                 rdfs:domain fem:Material ;
                                 rdfs:range xsd:double ;
                                 rdfs:comment "Specifies doping concentration in atomic percent." ;
                                 rdfs:label "hasDopantConcentration_atPct" .


###  http://example.org/fem-ontology#hasFilmThickness_nm
fem:hasFilmThickness_nm rdf:type owl:DatatypeProperty ;
                        rdfs:domain fem:Material ;
                        rdfs:range xsd:double ;
                        rdfs:comment "Specifies physical thickness of a thin film layer in nanometers." ;
                        rdfs:label "hasFilmThickness_nm" .


###  http://example.org/fem-ontology#hasGasFlow_sccm
fem:hasGasFlow_sccm rdf:type owl:DatatypeProperty ;
                    rdfs:domain fem:Unit_Process ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Specifies process gas flow rate in standard cubic centimeters per minute." ;
                    rdfs:label "hasGasFlow_sccm" .


###  http://example.org/fem-ontology#hasGrainSize_nm
fem:hasGrainSize_nm rdf:type owl:DatatypeProperty ;
                    rdfs:domain fem:Material ;
                    rdfs:range xsd:double ;
                    rdfs:comment "Specifies average crystallite grain size in nanometers." ;
                    rdfs:label "hasGrainSize_nm" .


###  http://example.org/fem-ontology#hasGrowthPerCycle_nm
fem:hasGrowthPerCycle_nm rdf:type owl:DatatypeProperty ;
                         rdfs:domain fem:Unit_Process ;
                         rdfs:range xsd:double ;
                         rdfs:comment "Specifies film thickness deposited per single ALD cycle in nanometers." ;
                         rdfs:label "hasGrowthPerCycle_nm" .


###  http://example.org/fem-ontology#hasHfZrRatio
fem:hasHfZrRatio rdf:type owl:DatatypeProperty ;
                 rdfs:domain fem:Material ;
                 rdfs:range xsd:double ;
                 rdfs:comment "Specifies stoichiometric ratio of Hafnium to Zirconium in HZO films." ;
                 rdfs:label "hasHfZrRatio" .


###  http://example.org/fem-ontology#hasProcessDuration_s
fem:hasProcessDuration_s rdf:type owl:DatatypeProperty ;
                         rdfs:domain fem:Unit_Process ;
                         rdfs:range xsd:double ;
                         rdfs:comment "Specifies execution time of a unit process step in seconds." ;
                         rdfs:label "hasProcessDuration_s" .


###  http://example.org/fem-ontology#hasProcessPressure_mbar
fem:hasProcessPressure_mbar rdf:type owl:DatatypeProperty ;
                            rdfs:domain fem:Unit_Process ;
                            rdfs:range xsd:double ;
                            rdfs:comment "Specifies operational chamber pressure during processing in millibars." ;
                            rdfs:label "hasProcessPressure_mbar" .


###  http://example.org/fem-ontology#hasProcessTemperature_C
fem:hasProcessTemperature_C rdf:type owl:DatatypeProperty ;
                            rdfs:domain fem:Unit_Process ;
                            rdfs:range xsd:double ;
                            rdfs:comment "Specifies process operating temperature in degrees Celsius." ;
                            rdfs:label "hasProcessTemperature_C" .


###  http://example.org/fem-ontology#hasPulseTime_s
fem:hasPulseTime_s rdf:type owl:DatatypeProperty ;
                   rdfs:domain fem:Unit_Process ;
                   rdfs:range xsd:double ;
                   rdfs:comment "Specifies duration of precursor gas injection pulses in seconds." ;
                   rdfs:label "hasPulseTime_s" .


###  http://example.org/fem-ontology#hasPurgeTime_s
fem:hasPurgeTime_s rdf:type owl:DatatypeProperty ;
                   rdfs:domain fem:Unit_Process ;
                   rdfs:range xsd:double ;
                   rdfs:comment "Specifies duration of purge gas clearing cycles in seconds." ;
                   rdfs:label "hasPurgeTime_s" .


###  http://example.org/fem-ontology#hasSpaceGroup
fem:hasSpaceGroup rdf:type owl:DatatypeProperty ;
                  rdfs:domain fem:Phase_State ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Specifies crystallographic space group notation." ;
                  rdfs:label "hasSpaceGroup" .


###  http://example.org/fem-ontology#hasTemperature_C
fem:hasTemperature_C rdf:type owl:DatatypeProperty ;
                     rdfs:domain fem:Measurement ;
                     rdfs:range xsd:double ;
                     rdfs:comment "Specifies ambient or stage temperature during testing in degrees Celsius." ;
                     rdfs:label "hasTemperature_C" .


###  http://example.org/fem-ontology#hasUnit
fem:hasUnit rdf:type owl:DatatypeProperty ;
            rdfs:domain fem:Measurement ;
            rdfs:range xsd:string ;
            rdfs:comment "Specifies standardized physical unit of measure." ;
            rdfs:label "hasUnit" .


###  http://example.org/fem-ontology#hasValue
fem:hasValue rdf:type owl:DatatypeProperty ;
             rdfs:domain fem:Measurement ;
             rdfs:range xsd:double ;
             rdfs:comment "Specifies quantitative numerical value obtained from a measurement." ;
             rdfs:label "hasValue" .


###  http://example.org/fem-ontology#isFerroelectric
fem:isFerroelectric rdf:type owl:DatatypeProperty ;
                    rdfs:domain fem:Phase_State ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "Boolean flag indicating whether a phase exhibits polar ferroelectricity." ;
                    rdfs:label "isFerroelectric" .


###  http://example.org/fem-ontology#operatingTime_ns
fem:operatingTime_ns rdf:type owl:DatatypeProperty ;
                     rdfs:domain fem:Memory_Array ;
                     rdfs:range xsd:double ;
                     rdfs:comment "Specifies array write/read access cycle time in nanoseconds." ;
                     rdfs:label "operatingTime_ns" .


#################################################################
#    Classes
#################################################################

###  http://example.org/fem-ontology#ALD
fem:ALD rdf:type owl:Class ;
        rdfs:subClassOf fem:Deposition ;
        rdfs:comment "Atomic Layer Deposition process class based on sequential self-limiting surface reactions." ;
        rdfs:label "ALD" .


###  http://example.org/fem-ontology#Amorphous
fem:Amorphous rdf:type owl:Class ;
              rdfs:subClassOf fem:Phase_State ;
              rdfs:comment "Non-crystalline phase lacking long-range atomic order." ;
              rdfs:label "Amorphous" .


###  http://example.org/fem-ontology#Artifact
fem:Artifact rdf:type owl:Class ;
             rdfs:comment "Physical substrate, integrated circuit specimen, array, or capacitor test vehicle." ;
             rdfs:label "Artifact" .


###  http://example.org/fem-ontology#BEOL_Process
fem:BEOL_Process rdf:type owl:Class ;
                 rdfs:subClassOf fem:Unit_Process ;
                 rdfs:comment "Back-End-of-Line manufacturing steps integrating memory elements into interconnect layers." ;
                 rdfs:label "BEOL_Process" .


###  http://example.org/fem-ontology#Capacitor_Based_Cell
fem:Capacitor_Based_Cell rdf:type owl:Class ;
                         rdfs:subClassOf fem:Memory_Cell_Architecture ;
                         rdfs:comment "Memory cell architecture using a ferroelectric capacitor for state storage." ;
                         rdfs:label "Capacitor_Based_Cell" .


###  http://example.org/fem-ontology#Crystalline_Phase
fem:Crystalline_Phase rdf:type owl:Class ;
                      rdfs:subClassOf fem:Phase_State ;
                      rdfs:comment "Solid phase possessing long-range crystallographic order." ;
                      rdfs:label "Crystalline_Phase" .


###  http://example.org/fem-ontology#Crystallisation_Anneal
fem:Crystallisation_Anneal rdf:type owl:Class ;
                           rdfs:subClassOf fem:Thermal_Process ;
                           rdfs:comment "Thermal process step driving phase transition from amorphous to crystalline state." ;
                           rdfs:label "Crystallisation_Anneal" .


###  http://example.org/fem-ontology#Deposition
fem:Deposition rdf:type owl:Class ;
               rdfs:subClassOf fem:Unit_Process ;
               rdfs:comment "Additive manufacturing process forming thin film layers." ;
               rdfs:label "Deposition" .


###  http://example.org/fem-ontology#Deposition_Tool
fem:Deposition_Tool rdf:type owl:Class ;
                    rdfs:subClassOf fem:Equipment ;
                    rdfs:comment "Processing tool dedicated to film deposition." ;
                    rdfs:label "Deposition_Tool" .


###  http://example.org/fem-ontology#Dielectric_Layer_Material
fem:Dielectric_Layer_Material rdf:type owl:Class ;
                              rdfs:subClassOf fem:Material ;
                              rdfs:comment "Electrical insulating material." ;
                              rdfs:label "Dielectric_Layer_Material" .


###  http://example.org/fem-ontology#Doped_HfO2
fem:Doped_HfO2 rdf:type owl:Class ;
               rdfs:subClassOf fem:Ferroelectric_Material ;
               rdfs:comment "Hafnium oxide doped with species such as Si, Zr, Al, Y, or La to induce ferroelectricity." ;
               rdfs:label "Doped_HfO2" .


###  http://example.org/fem-ontology#Electrode_Material
fem:Electrode_Material rdf:type owl:Class ;
                       rdfs:subClassOf fem:Material ;
                       rdfs:comment "Electrically conductive material used for capacitor terminal contact layers." ;
                       rdfs:label "Electrode_Material" .


###  http://example.org/fem-ontology#Equipment
fem:Equipment rdf:type owl:Class ;
              rdfs:comment "Semiconductor fabrication equipment or metrology instrument." ;
              rdfs:label "Equipment" .


###  http://example.org/fem-ontology#Etch
fem:Etch rdf:type owl:Class ;
         rdfs:subClassOf fem:Unit_Process ;
         rdfs:comment "Subtractive unit process selectively removing material regions." ;
         rdfs:label "Etch" .


###  http://example.org/fem-ontology#Etch_Tool
fem:Etch_Tool rdf:type owl:Class ;
              rdfs:subClassOf fem:Equipment ;
              rdfs:comment "Tool equipment designed for plasma or wet chemical etching." ;
              rdfs:label "Etch_Tool" .


###  http://example.org/fem-ontology#FeRAM_1T1C_Capacitance_Sensed
fem:FeRAM_1T1C_Capacitance_Sensed rdf:type owl:Class ;
                                  rdfs:subClassOf fem:Capacitor_Based_Cell ;
                                  rdfs:comment "1T1C FeRAM cell employing differential capacitance sensing." ;
                                  rdfs:label "FeRAM_1T1C_Capacitance_Sensed" .


###  http://example.org/fem-ontology#FeRAM_1T1C_Charge_Sensed
fem:FeRAM_1T1C_Charge_Sensed rdf:type owl:Class ;
                             rdfs:subClassOf fem:Capacitor_Based_Cell ;
                             rdfs:comment "1T1C FeRAM cell employing polarization switching displacement charge sensing." ;
                             rdfs:label "FeRAM_1T1C_Charge_Sensed" .


###  http://example.org/fem-ontology#Ferroelectric_Material
fem:Ferroelectric_Material rdf:type owl:Class ;
                           rdfs:subClassOf fem:Material ;
                           rdfs:comment "Material possessing spontaneous electric polarization reversible by electric field." ;
                           rdfs:label "Ferroelectric_Material" .


###  http://example.org/fem-ontology#Hafnium_Zirconate
fem:Hafnium_Zirconate rdf:type owl:Class ;
                      rdfs:subClassOf fem:Ferroelectric_Material ;
                      rdfs:comment "Hf1-xZrxO2 solid solution binary dielectric material system." ;
                      rdfs:label "Hafnium_Zirconate" .


###  http://example.org/fem-ontology#Interfacial_Layer_Material
fem:Interfacial_Layer_Material rdf:type owl:Class ;
                               rdfs:subClassOf fem:Dielectric_Layer_Material ;
                               rdfs:comment "Thin interfacial layer formed between electrode and ferroelectric film." ;
                               rdfs:label "Interfacial_Layer_Material" .


###  http://example.org/fem-ontology#Layer_Stack
fem:Layer_Stack rdf:type owl:Class ;
                rdfs:comment "Sequential vertical arrangement of thin material layers." ;
                rdfs:label "Layer_Stack" .


###  http://example.org/fem-ontology#Lithography
fem:Lithography rdf:type owl:Class ;
                rdfs:subClassOf fem:Unit_Process ;
                rdfs:comment "Photolithographic pattern transfer unit process." ;
                rdfs:label "Lithography" .


###  http://example.org/fem-ontology#MFM
fem:MFM rdf:type owl:Class ;
        rdfs:subClassOf fem:Layer_Stack ;
        rdfs:comment "Metal-Ferroelectric-Metal capacitor layer stack." ;
        rdfs:label "MFM" .


###  http://example.org/fem-ontology#Material
fem:Material rdf:type owl:Class ;
             rdfs:comment "Chemical substance or thin film composition used in semiconductor structures." ;
             rdfs:label "Material" .


###  http://example.org/fem-ontology#Measured_Property
fem:Measured_Property rdf:type owl:Class ;
                      rdfs:comment "Physical parameter or performance characteristic evaluated during measurement." ;
                      rdfs:label "Measured_Property" .


###  http://example.org/fem-ontology#Measurement
fem:Measurement rdf:type owl:Class ;
                rdfs:comment "Quantitative characterization record obtained from metrology tests." ;
                rdfs:label "Measurement" .


###  http://example.org/fem-ontology#Measurement_Method
fem:Measurement_Method rdf:type owl:Class ;
                       rdfs:comment "Characterization technique or protocol applied during metrology." ;
                       rdfs:label "Measurement_Method" .


###  http://example.org/fem-ontology#Memory_Array
fem:Memory_Array rdf:type owl:Class ;
                 rdfs:subClassOf fem:Artifact ;
                 rdfs:comment "Integrated matrix array of memory cells." ;
                 rdfs:label "Memory_Array" .


###  http://example.org/fem-ontology#Memory_Cell_Architecture
fem:Memory_Cell_Architecture rdf:type owl:Class ;
                             rdfs:comment "Circuit design scheme defining individual memory element topologies." ;
                             rdfs:label "Memory_Cell_Architecture" .


###  http://example.org/fem-ontology#Orthorhombic_Pca21
fem:Orthorhombic_Pca21 rdf:type owl:Class ;
                       rdfs:subClassOf fem:Crystalline_Phase ;
                       rdfs:comment "Non-centrosymmetric polar orthorhombic crystalline phase responsible for ferroelectricity in HfO2." ;
                       rdfs:label "Orthorhombic_Pca21" .


###  http://example.org/fem-ontology#PVD
fem:PVD rdf:type owl:Class ;
        rdfs:subClassOf fem:Deposition ;
        rdfs:comment "Physical Vapor Deposition unit process." ;
        rdfs:label "PVD" .


###  http://example.org/fem-ontology#Phase_State
fem:Phase_State rdf:type owl:Class ;
                rdfs:comment "Crystallographic structure or phase state of a solid material." ;
                rdfs:label "Phase_State" .


###  http://example.org/fem-ontology#Polarisation_Property
fem:Polarisation_Property rdf:type owl:Class ;
                          rdfs:subClassOf fem:Measured_Property ;
                          rdfs:comment "Ferroelectric polarization property such as remanent polarization or coercive field." ;
                          rdfs:label "Polarisation_Property" .


###  http://example.org/fem-ontology#Process_Flow
